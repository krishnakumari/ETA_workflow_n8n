    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let data = item.json;\n  try {\n    // Parse AI output if it is a JSON string\n    if (typeof data.output === 'string') data = JSON.parse(data.output);\n    else if (typeof data.text === 'string') data = JSON.parse(data.text);\n    else if (typeof data.result === 'string') data = JSON.parse(data.result);\n\n    data.Student_ID = String(data.Student_ID || '').trim();\n    data.Name = String(data.Name || '').trim();\n    data.Email = String(data.Email || '').trim().toLowerCase();\n    const phoneDigits = String(data.Phone || '').replace(/[^0-9]/g, '');\n    data.Phone = phoneDigits.length >= 10 ? phoneDigits : 'MISSING';\n    data.Course = String(data.Course || '').trim();\n    data.City = String(data.City || '').trim();\n    data.Email_Valid = /^[^ @]+@[^ @]+[.][^ @]+$/.test(data.Email);\n    return { json: data };\n  } catch (error) {\n    return { json: { error: 'Invalid JSON', raw: item.json } };\n  }\n});"
      },
